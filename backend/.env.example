# Optional for the S1-05 development validation script.
# Generate a personal token at https://www.discogs.com/settings/developers
# Copy this file to .env and fill the value locally. Never commit the real token.
# The script reads environment variables; it does not automatically load .env.
DISCOGS_TOKEN=

# Optional recognition settings (S2-03); defaults are shown. See docs/S2-03.md.
# JAMSCAN_MODEL_PATH=models/dinov2-small.onnx
# JAMSCAN_INDEX_DIR=data/index
# JAMSCAN_MATCH_THRESHOLD=0.75
# JAMSCAN_MATCH_MARGIN=0.05
# JAMSCAN_REVIEW_THRESHOLD=0.60
